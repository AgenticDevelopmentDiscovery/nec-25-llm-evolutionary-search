# Copy to demo/.env. Enter YOUR key locally; never commit demo/.env.
# TAMU: Settings > Account > API Key at https://chat.tamu.ai/
# Create a web chat first. See https://docs.tamus.ai/docs/prod/api-tool/create-and-test-api-key
DEMO_LLM_PROVIDER=tamu
TAMUS_AI_CHAT_API_KEY=
TAMUS_AI_CHAT_MODEL=protected.gpt-5.6-luna
TAMUS_AI_CHAT_API_ENDPOINT=https://chat-api.tamu.ai

# Optional direct OpenAI access: set DEMO_LLM_PROVIDER=openai instead.
# These credentials are never reused for TAMU.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
